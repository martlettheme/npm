{
  "schemaVersion": 1,
  "primitives": [
    "container",
    "stack",
    "cluster",
    "grid",
    "sidebar",
    "split"
  ],
  "compositions": [
    "article",
    "landing",
    "documentation"
  ],
  "defaults": {
    "space": "regular",
    "columns": 3,
    "splitRatio": "wide-start",
    "sidebarSide": "end"
  },
  "tokens": {
    "layout-gap": "1.5rem",
    "layout-gap-small": ".75rem",
    "layout-gap-large": "2.5rem",
    "layout-sidebar-width": "16rem",
    "layout-main-min": "30rem",
    "layout-grid-min": "18rem",
    "layout-split-min": "20rem",
    "layout-section-space": "clamp(3rem, 6vw, 6rem)"
  },
  "sources": [
    {
      "url": "https://jameshoward.us/",
      "repository": "k3jph/k3jph.github.io",
      "commit": "32b7166a629ea696147d0d779d911b713e4baf7e",
      "files": [
        "src/styles/global.css",
        "src/styles/document-pages.css",
        "src/styles/content.css",
        "src/components/PageIntro.astro",
        "src/components/ProjectShowcase.astro"
      ]
    },
    {
      "url": "https://martlettheme.dev/",
      "repository": "martlettheme/martlettheme",
      "commit": "39bf200d265ced6b893fa4ad186c75691ba2ec94",
      "files": [
        "site/src/pages/index.astro",
        "site/src/styles/global.css"
      ]
    }
  ],
  "normalization": {
    "intrinsicSizing": "Columns and sidebars respond to their available container width, including nested containers, rather than only to viewport breakpoints.",
    "readingOrder": "Sidebar side selects matching DOM order; split content retains its source order at all widths.",
    "scope": "Namespaced optional layout classes; no global reset, framework dependency, image, personal identity, or scripts."
  }
}
